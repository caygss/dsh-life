#!/bin/sh
# 本地兜底：没有服务端分支保护时，push 前先跑和 CI 一样的两步。
# 逻辑在 check.mjs 里（Windows 上直接 `node .githooks/check.mjs` 也能跑）。
# 安装：git config core.hooksPath .githooks
set -e

if ! command -v node >/dev/null 2>&1; then
  echo "[pre-push] node not found on PATH; skipping checks" >&2
  exit 0
fi

exec node "$(dirname "$0")/check.mjs"
